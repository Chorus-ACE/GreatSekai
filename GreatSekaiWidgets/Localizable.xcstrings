    "Collections.widget-description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show random artwork from the card catalog or rotate through a selected collection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード図鑑からランダムに選んだイラストや、選択したコレクションのイラストを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 도감에서 무작위로 고른 일러스트나 선택한 컬렉션의 일러스트를 표시합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随机显示图鉴中的卡面，或轮播所选收藏集中的卡面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隨機顯示圖鑑中的卡面，或輪播所選收藏集中的卡面。"
          }
        }
      }
    },
    "Collections.widget-empty" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
