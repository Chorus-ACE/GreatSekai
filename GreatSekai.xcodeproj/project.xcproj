{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "ja",
      "ko",
      "zh-Hans",
      "zh-Hant",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "Packages/SekaiMediaPipe",
    }, {
      "kind": "local",
      "path": "../SekaiKit",
    }, {
      "kind": "remote",
      "repository": "https://github.com/SDWebImage/SDWebImageSwiftUI",
      "version": {
        "up-to-next-major-version": "3.1.4",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/SDWebImage/SDWebImageSVGCoder",
      "version": {
        "up-to-next-major-version": "1.8.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/gonzalezreal/swift-markdown-ui",
      "version": {
        "up-to-next-major-version": "2.4.1",
      },
    },
  ],
