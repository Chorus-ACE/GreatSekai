  "targets": [
    {
      "name": "GreatSekai",
      "id": "E9C55F4B2F53F1E700DCFD2D",
      "product": "Products/GreatSekai.app",
      "product-type": "application",
      "dependencies": [
        "GreatSekaiWidgets",
      ],
      "build-phases": [
        {
          "kind": "copy",
          "name": "Embed App Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Embed Cubism Metal Shaders",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/Packages/Live2DKit/Vendor",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/FrameworkMetallibs/",
          ],
          "output-file-list-paths": [
            "$(SRCROOT)/Packages/Live2DKit/Scripts/FrameworkMetallibsOutputs.xcfilelist",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "set -eu",
            "shader_source=\"$SRCROOT/Packages/Live2DKit/Vendor/FrameworkMetallibs-$PLATFORM_NAME\"",
            "if [ -d \"$SRCROOT/Packages/Live2DKit/Vendor/Live2DCubismCore.xcframework\" ]; then",
            "    if [ ! -f \"$shader_source/MetalShaders.metallib\" ]; then",
            "        echo \"error: Cubism shaders missing. Run Packages/Live2DKit/Scripts/build-metallibs.sh $PLATFORM_NAME first.\"",
            "        exit 1",
            "    fi",
            "    /bin/mkdir -p \"$TARGET_BUILD_DIR/$UNLOCALIZED_RESOURCES_FOLDER_PATH/FrameworkMetallibs\"",
            "    /bin/cp -X \"$shader_source\"/*.metallib \"$TARGET_BUILD_DIR/$UNLOCALIZED_RESOURCES_FOLDER_PATH/FrameworkMetallibs/\"",
            "fi",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "product-name": "SekaiKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "SekaiMediaPipe",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "SDWebImageSVGCoder",
          "product-name": "SDWebImageSVGCoder",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "SDWebImageSwiftUI",
          "product-name": "SDWebImageSwiftUI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-markdown-ui",
          "product-name": "MarkdownUI",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "GreatSekai/GreatSekai.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "5",
        "DEVELOPMENT_TEAM": "MU2GGQV46U",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_FILE_ACCESS_DOWNLOADS_FOLDER": "readwrite",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "NO",
        "ENABLE_RESOURCE_ACCESS_BLUETOOTH": "NO",
        "ENABLE_RESOURCE_ACCESS_CALENDARS": "NO",
        "ENABLE_RESOURCE_ACCESS_CAMERA": "YES",
        "ENABLE_RESOURCE_ACCESS_CONTACTS": "NO",
        "ENABLE_RESOURCE_ACCESS_LOCATION": "NO",
        "ENABLE_RESOURCE_ACCESS_PRINTING": "NO",
        "ENABLE_RESOURCE_ACCESS_USB": "NO",
        "ENABLE_USER_SELECTED_FILES": "readwrite",
        "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "GreatSekai/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "GreatSekai",
