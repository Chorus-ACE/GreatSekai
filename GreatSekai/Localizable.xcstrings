    "Settings.advanced.storage.cache.management.introduction" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select the caches you want to remove. Removing cached data won't affect app functionality or your preferences. Deleted caches will be downloaded again as needed."
