        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "버그나 충돌이 발생하면 언제든지 알려 주세요. 보내 주신 의견은 큰 도움이 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎随时向我们反馈任何问题或崩溃问题，我们非常乐意接受这些报告。"
