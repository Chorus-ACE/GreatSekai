    "Settings.models.tools.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable only when both the service and model support function tools. This adapter supports text and optional tools; images, guided generation, and reasoning controls are not supported."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスとモデルの両方が関数ツールに対応している場合のみ有効にしてください。このアダプタはテキストと任意のツール呼び出しに対応します。画像、構造化生成、推論設定には対応しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서비스와 모델이 모두 함수 도구를 지원할 때만 활성화하세요. 이 어댑터는 텍스트와 선택적 도구 호출을 지원하며 이미지, 구조화 생성 및 추론 설정은 지원하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在服务和模型都支持函数工具时开启。此适配器支持文本和可选工具调用，暂不支持图片、引导式生成和推理参数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在服務和模型都支援函式工具時開啟。此轉接器支援文字和選用的工具呼叫，暫不支援圖片、引導式生成和推理參數。"
          }
        }
      }
    },
