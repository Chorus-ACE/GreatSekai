    "Time-zone.%@.%@.%lld" : {
      "comment" : "A string describing the time difference between two time zones. The first argument is the string “Time-zone.today”, the string “Time-zone.yesterday”, or the string “Time-zone.tomorrow”. The second argument is a plus or minus sign followed by the absolute value of the hour difference.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$(Date)@, %2$(Symbol)@%3$(Offset)lldHR"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$(Date)@, %2$(Symbol)@%3$(Offset)lldHRS"
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$(Date)@, %2$(Symbol)@%3$(Offset)lld小时"
                }
              }
            }
          }
        }
      }
    },
