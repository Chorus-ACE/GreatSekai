    "Gacha.cards.special-rates" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Individual rates depend on card selection or special draw rules. Relative weights are shown where a fixed rate cannot be calculated."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "カードごとの提供割合は、選択したカードや特別なガチャルールによって異なります。固定の提供割合を計算できない場合は相対的な重みを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "개별 확률은 카드 선택 또는 특별 뽑기 규칙에 따라 달라집니다. 고정 확률을 계산할 수 없는 경우 상대 가중치가 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单卡概率取决于自选卡牌或特殊抽取规则。无法计算固定概率时显示相对权重。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單卡機率取決於自選卡片或特殊抽取規則。無法計算固定機率時顯示相對權重。"
          }
        }
      }
    },
