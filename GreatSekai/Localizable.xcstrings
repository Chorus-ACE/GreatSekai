    "Whats-new.testflight-note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please feel free to report any bug or crashes to us, we would be very happy to receive these feedbacks."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "不具合やクラッシュが発生した場合は、ぜひご報告ください。フィードバックをお待ちしています。"
