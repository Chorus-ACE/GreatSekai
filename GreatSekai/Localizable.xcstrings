    "Settings.models.privacy" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you use an online model, prompts and supplied context are sent to your configured service. Your provider may charge for requests. API keys are stored in this device’s Keychain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンラインモデルの使用時は、プロンプトとコンテキストが設定したサービスに送信されます。利用料金が発生する場合があります。APIキーはこのデバイスのキーチェーンに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온라인 모델을 사용하면 프롬프트와 컨텍스트가 설정한 서비스로 전송됩니다. 제공업체에서 요금을 부과할 수 있습니다. API 키는 이 기기의 키체인에 저장됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用在线模型时，提示词及提供的上下文会发送至你配置的服务，提供方可能收取费用。API Key 存储在此设备的钥匙串中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用線上模型時，提示詞及提供的上下文會傳送至你設定的服務，供應商可能收費。API Key 儲存在此裝置的鑰匙圈中。"
          }
        }
      }
    },
