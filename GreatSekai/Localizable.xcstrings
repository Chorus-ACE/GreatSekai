    "Settings.models.chatgpt.error.sign-out" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signed out on this device, but remote revocation could not be confirmed. Disconnect GreatSekai in ChatGPT Settings to end remote access."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスではサインアウトしましたが、サーバーでの失効を確認できませんでした。ChatGPT の設定で GreatSekai の接続を解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서는 로그아웃했지만 원격 세션 취소를 확인하지 못했습니다. ChatGPT 설정에서 GreatSekai 연결을 해제하세요."
          }
        },
        "zh-Hans" : {
